{
    "name": "eirworks/carol",
    "description": "Carol search engine core: RSS/Atom crawler, feed parser, search item model, migration and source resources.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "crawler",
        "rss",
        "atom",
        "search"
    ],
    "require": {
        "php": "^8.2",
        "ext-simplexml": "*",
        "illuminate/cache": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.34|^3.0"
    },
    "autoload": {
        "psr-4": {
            "eirworks\\carol\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "eirworks\\carol\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "eirworks\\carol\\CarolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
